# ─── Firebase Configuration ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─── Razorpay Configuration ────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_* keys for testing, rzp_live_* for production
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX

# Razorpay Subscription Plan IDs
# Create plans at: Razorpay Dashboard → Subscriptions → Plans → + Create Plan
VITE_RAZORPAY_PLAN_GROWTH=plan_XXXXXXXXXX
VITE_RAZORPAY_PLAN_PRO=plan_XXXXXXXXXX

# ─── Backend (Firebase Cloud Functions) ───────────────────────────────
# After deploying functions, paste the base URL here
# Format: https://REGION-PROJECT_ID.cloudfunctions.net
VITE_BACKEND_URL=https://asia-south1-your-project.cloudfunctions.net
